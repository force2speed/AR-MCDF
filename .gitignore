# AR-MCDF  |  .gitignore
# ======================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment secrets
.env
# (keep .env.example)

# Logs
*.log
logs/

# Models — too large for git; use git-lfs or share separately
models/*.pt
models/*.npy

# Data — raw CSV files are large; download from UNSW-NB15 official site
data/raw/*.csv

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Coverage
.coverage
htmlcov/
